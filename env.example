# Application
APP_ENV=development
HTTP_ADDRESS=:8080
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://voting:voting@localhost:5433/voting?sslmode=disable

# Redis (comma-separated; single node for local compose)
REDIS_ADDRESSES=localhost:6380
REDIS_DB=0

# Admin (min 32 chars)
ADMIN_TOKEN=0123456789abcdef0123456789abcdef

# Sync job (compose sync loop / make sync-once)
SYNC_TIMEOUT=30s
SYNC_SETTLE_AFTER=10m

# Cookie
VOTER_COOKIE_NAME=voter_id
VOTER_COOKIE_SECURE=false
